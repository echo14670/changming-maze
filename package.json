{
  "name": "changming-maze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "《长明：雾海迷宫》——基于 WebGL2 / three.js 的第一人称 3D 迷宫（计算机图形学综合实验四）",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=dist/bundle.js",
    "watch": "esbuild src/main.js --bundle --format=iife --outfile=dist/bundle.js --watch",
    "test": "node tests/smoke.cjs",
    "test:config": "node --test tests/config.test.mjs",
    "capture:render-lab": "node tools/capture-render-comparisons.cjs",
    "capture:main-render": "node tools/capture-main-render.cjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1"
  }
}
